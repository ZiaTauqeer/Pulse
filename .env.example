# Copy this file to .env and fill in real values.

# PostgreSQL connection string. For local development against the
# instance this project was verified against:
#   postgresql://postgres:<password>@localhost:5432/pulse?schema=public
# For Vercel, use your hosted Postgres provider's connection string
# (Vercel Postgres, Neon, Supabase, etc.).
DATABASE_URL="postgresql://user:password@localhost:5432/pulse?schema=public"

# Required by Auth.js to sign session JWTs. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 32
# In local dev, Auth.js will generate a temporary one automatically if
# this is unset - but it changes every restart (logging everyone out),
# and production REQUIRES this to be set explicitly.
AUTH_SECRET=""


# AI assistant (app/(dashboard)/assistant, app/api/ai/query). Required for
# the assistant to function; other pages work fine without it.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5"   # optional override

# Astra DB - behavioral similarity search (src/lib/astra/, the
# search_similar_customers AI tool). Optional: the app and assistant work
# without it, that one tool just reports it's unavailable. Get these from
# https://astra.datastax.com after creating a serverless vector database.
ASTRA_DB_API_ENDPOINT=""
ASTRA_DB_APPLICATION_TOKEN=""

